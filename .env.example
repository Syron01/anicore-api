# AniCore API configuration
# Copy this file to .env (all values optional)

# Server
PORT=3000
NODE_ENV=development

# Cache (in-memory by default, TTL in seconds)
CACHE_TTL=600
CACHE_MAX_ITEMS=5000

# Optional: Redis URL for shared cache across instances
# REDIS_URL=redis://localhost:6379

# Per-provider concurrency (parallel in-flight requests)
ANILIST_CONCURRENCY=3
KITSU_CONCURRENCY=5

# CORS: comma-separated origins, or * for all
CORS_ORIGIN=*
